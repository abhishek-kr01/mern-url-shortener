{
  "name": "url-shortner-api",
  "version": "1.0.0",
  "description": "This project contains url shortner apis",
  "license": "ISC",
  "author": "Abhishek Kumar",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec \"node --loader ts-node/esm src/server.ts\"",
    "dev:fast": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node ./dist/server.js",
    "start:prod": "npm run build && npm run start",
    "lint": "eslint . --ext .ts,.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mongoose": "^8.20.0",
    "nanoid": "^3.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^24.10.1",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
